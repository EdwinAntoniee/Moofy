# ─────────────────────────────────────────────────────────────
# Moofy Environment Variables Template
# ─────────────────────────────────────────────────────────────

# Backend Configuration (FastAPI)
JWT_SECRET_KEY=moofy-super-secret-jwt-key-production-2026
TMDB_API_KEY=your_tmdb_api_key_here
CORS_ORIGINS=https://moofy.vercel.app,http://localhost:5173

# Frontend Configuration (Vite / Vercel)
# Point this to your live FastAPI backend URL (e.g., on Render or Railway)
VITE_API_URL=https://moofy-backend.onrender.com/api
